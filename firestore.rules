rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // USERS
    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow write: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    // WEDDINGS
    match /weddings/{weddingId} {
      // Allow public read of basic wedding info so guests can load invitation details
      allow read: if true;
      
      // Create: Allow admins (for test weddings)
      allow create: if isSignedIn() && isAdmin();
      
      // Update: Allow Admins OR the couple that owns it
      allow update: if isSignedIn() && (
        isAdmin() || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.weddingId == weddingId
      );
      
      // Delete: Deletes go through Server Action (firebase-admin)
      allow delete: if false;

      // INVITATIONS (Public read so guests can load their envelope)
      match /invitations/{invitationId} {
        allow read: if true;
        allow write: if isSignedIn() && (
          isAdmin() || 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.weddingId == weddingId
        );
      }

      // GUESTS (Public read & update so guests can confirm attendance, allergies, bus, songs, messages)
      match /guests/{guestId} {
        allow read: if true;
        allow update: if true;
        allow create, delete: if isSignedIn() && (
          isAdmin() || 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.weddingId == weddingId
        );
      }

      // OTHER SUBCOLLECTIONS (tables, expenses, etc.)
      match /{document=**} {
        allow read, write: if isSignedIn() && (
          isAdmin() || 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.weddingId == weddingId
        );
      }
    }

    // WEDDING REQUESTS
    match /wedding_requests/{requestId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isSignedIn() && isAdmin();
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // AUDIT LOGS
    match /audit_logs/{logId} {
      allow create: if isSignedIn() && isAdmin();
      allow read: if isSignedIn() && isAdmin();
    }
  }
}

